rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    // 受取口座ゲートのサーバー強制（settings/platform.requireConnect==true のときのみ有効）
    function connectGateOn() {
      return exists(/databases/$(database)/documents/settings/platform)
        && get(/databases/$(database)/documents/settings/platform).data.requireConnect == true;
    }
    function isAdmin() {
      return authed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ユーザー：閲覧はログインユーザー全員、編集は本人と管理者のみ
    match /users/{uid} {
      // 本人による更新では verified は「変更なし」または「pending（申請）」のみ許可
      function selfVerifyOk() {
        return request.resource.data.get('verified','none') == resource.data.get('verified','none')
            || request.resource.data.get('verified','none') == 'pending';
      }
      allow read: if authed();
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.get('verified','none') != 'approved'
        && request.resource.data.get('isAdmin', false) != true;
      allow update: if isAdmin()
        || (authed() && request.auth.uid == uid
            && selfVerifyOk()
            && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
            // Stripe口座情報はFunctions（Admin SDK）のみが書き込む
            && request.resource.data.get('stripeAccountId', '') == resource.data.get('stripeAccountId', '')
            && request.resource.data.get('stripeChargesEnabled', false) == resource.data.get('stripeChargesEnabled', false))
        // レビュー投稿に伴う評価集計フィールドのみの更新は許可
        // （改ざん耐性を高めたい場合は functions の recalcRating を有効化し、この行を削除）
        || (authed()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg','ratingCount','lessonCount']));
      allow delete: if false; // 退会は deleted フラグで論理削除
    }

    // いいね：作成は本人（from）のみ
    match /likes/{id} {
      allow read: if authed();
      // ドキュメントIDは「送信者_受信者」に固定（本人以外のいいねを作れない）
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow update, delete: if false;
    }

    // マッチ：当事者のみ閲覧・作成（双方向いいね成立時にクライアントが作成）
    match /matches/{id} {
      // get: 存在しないdoc（resource == null）への読み取りを許容する。
      // これがないと「マッチ作成前の存在確認」が全ユーザーで拒否され、初回マッチが作れない。
      // 未存在docの読取を許すだけなので情報漏れは増えない
      allow get: if authed()
        && (resource == null || request.auth.uid in resource.data.users || isAdmin());
      // list: 当事者のクエリ（users array-contains 自分）または管理者のみ
      allow list: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      // 双方向の「いいね」が実在する場合のみマッチを作成できる（強制マッチの防止）
      allow create: if authed()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1]))
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0]));
      allow update, delete: if isAdmin();

      // チャット：マッチ当事者のみ
      match /messages/{mid} {
        allow read, create: if authed() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.users;
        allow update, delete: if false;
      }
    }

    // 契約：当事者と管理者のみ
    match /contracts/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed() && (request.auth.uid == request.resource.data.coach
                    || request.auth.uid == request.resource.data.player);
      allow update: if authed()
        && (request.auth.uid == resource.data.coach
            || request.auth.uid == resource.data.player || isAdmin())
        // 契約開始（active への遷移）は、ゲート強制ON時はコーチの受取口座設定を必須にする
        && (isAdmin()
            || !(request.resource.data.status == 'active' && resource.data.status != 'active')
            || !connectGateOn()
            || get(/databases/$(database)/documents/users/$(resource.data.coach)).data.stripeChargesEnabled == true);
      allow delete: if false;
    }

    // 本人確認書類：本人の提出、本人と管理者のみ閲覧可
    match /verify_docs/{uid} {
      allow read: if authed() && (request.auth.uid == uid || isAdmin());
      allow create, update: if authed() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // 通報：作成は誰でも、閲覧・対応は管理者のみ
    match /reports/{id} {
      allow create: if authed();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // 通知：宛先本人のみ閲覧・既読化。作成はログインユーザー（いいね等の相手宛通知）
    match /notifications/{id} {
      allow read, update: if authed() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if authed()
        && request.resource.data.type in ['like','match','msg','contract','pay','review','verify','cert','announce']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.to is string;
      allow delete: if false;
    }

    // 決済：閲覧は当事者と管理者。
    // Stripe連携時はCloud Functions（Admin SDK）のみが書き込むため create を false に変更推奨。
    // 手動記録（銀行振込など）を使う場合のみ、支払者本人による create を許可する。
    match /payments/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed()
        && request.resource.data.player == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.fee is number && request.resource.data.fee >= 0;
      allow update: if isAdmin(); // 精算フラグ（payoutId）の付与のみ想定
      allow delete: if isAdmin(); // 誤記録の取消（管理画面から。監査ログに記録される）
    }

    // 精算（事務局→コーチへの振込記録）：作成は管理者のみ
    match /payouts/{id} {
      allow read: if authed() && (resource.data.coach == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Stripe Webhookの冪等化記録（サーバー専用）
    match /stripe_events/{id} {
      allow read, write: if false;
    }

    // レビュー：閲覧は全員、作成は投稿者本人のみ
    match /reviews/{id} {
      function ct() {
        return get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data;
      }
      allow read: if authed();
      // 完了済み契約の当事者のみ、契約相手に対して投稿できる
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && ct().status == 'completed'
        && (request.auth.uid == ct().coach || request.auth.uid == ct().player)
        && request.resource.data.to == (request.auth.uid == ct().coach ? ct().player : ct().coach);
      allow update, delete: if isAdmin();
    }

    // 指導者募集：閲覧はログインユーザー、作成・更新はチーム本人（と管理者）
    match /recruitments/{id} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.teamId == request.auth.uid;
      allow update: if authed() && (resource.data.teamId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 実績証明書：申請は本人、発行・失効は事務局のみ。
    // 証明書番号（推測困難なランダムID）を知る第三者は真正性を確認できる（get）
    match /certificates/{id} {
      allow get: if true;
      allow list: if authed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if authed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.stats == null;
      allow update, delete: if isAdmin();
    }

    // レッスン予約（空き枠予約）：契約当事者のみ作成・閲覧・返答できる
    match /bookings/{id} {
      allow get: if authed() && (resource == null || request.auth.uid in resource.data.users || isAdmin());
      allow list: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      allow create: if authed()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.by == request.auth.uid
        && request.resource.data.users.hasAll([request.resource.data.coach, request.resource.data.player]);
      allow update: if authed() && (request.auth.uid in resource.data.users);
      allow delete: if false;
    }

    // プラットフォーム設定（受取口座ゲートの強制など）：変更は事務局のみ
    match /settings/{id} {
      allow read: if authed();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 運営からのお知らせ：閲覧は全ログインユーザー、配信は事務局のみ
    match /announcements/{id} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    // 管理操作の監査ログ：事務局のみ。改ざん防止のため更新・削除は不可
    match /audit_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // メール送信キュー（Trigger Email拡張専用。クライアントは触れない）
    match /mail/{id} {
      allow read, write: if false;
    }
  
    /* =================================================================
       MyCOACH-MyTEAM（地域クラブ運営）
       ================================================================= */
    function club(c) { return get(/databases/$(database)/documents/clubs/$(c)).data; }
    function isMember(c) { return authed() && request.auth.uid in club(c).memberUids; }
    function isClubAdmin(c) { return authed() && request.auth.uid in club(c).adminUids; }
    function isStaff(c) { return authed() && (request.auth.uid in club(c).adminUids || request.auth.uid in club(c).coachUids); }
    // 自分自身だけを配列に追加する変更か
    function onlyAddsMe(field) {
      return request.resource.data.get(field, []).hasAll(resource.data.get(field, []))
        && request.resource.data.get(field, []).removeAll(resource.data.get(field, [])).hasOnly([request.auth.uid]);
    }

    // 招待コード → クラブID。コードを知っている人だけが引ける（一覧は不可）
    match /invites/{code} {
      allow get: if authed();
      allow list: if false;
      allow create: if authed() && club(request.resource.data.clubId).ownerUid == request.auth.uid
        && request.resource.data.role in ['member', 'coach'];
      allow update, delete: if false;
    }

    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    match /clubs/{c} {
      // 会員のみ閲覧可（招待コードを含むため）
      allow get: if isMember(c);
      allow list: if false;
      allow create: if authed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.coachUids.size() == 0;
      // 運営は自由に更新。それ以外は「正しい招待コードで、自分を会員に加える」だけ許可。
      // 指導者（coachUids）への追加は、指導者用の招待コードの場合のみ
      allow update: if isClubAdmin(c)
        || (authed()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'coachUids', 'joinCode'])
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
            && invite(request.resource.data.joinCode).clubId == c
            && onlyAddsMe('memberUids')
            && (request.resource.data.get('coachUids', []) == resource.data.get('coachUids', [])
                || (onlyAddsMe('coachUids') && invite(request.resource.data.joinCode).role == 'coach')));
      allow delete: if false;

      // 会員：運営・指導者は全員分、保護者は自分の家庭の分だけ
      match /players/{p} {
        allow read: if isStaff(c) || (isMember(c) && request.auth.uid in resource.data.guardianUids);
        allow create: if isClubAdmin(c) || (isMember(c) && request.resource.data.guardianUids == [request.auth.uid] && request.resource.data.discount == 0);
        allow update: if isClubAdmin(c)
          || (isMember(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianUids']) && onlyAddsMe('guardianUids'));
        allow delete: if isClubAdmin(c);
      }
      // 予定：運営・指導者が作成。会員は出欠（att）だけ更新できる
      match /events/{e} {
        allow read: if isMember(c);
        allow create, delete: if isStaff(c);
        allow update: if isStaff(c) || (isMember(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['att']));
      }
      match /announcements/{a} {
        allow read: if isMember(c);
        allow create: if isStaff(c) && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update, delete: if isClubAdmin(c);
      }
      // 体調・練習記録：運営・指導者と、記録した本人だけが読める
      match /conditions/{x} {
        allow read: if isStaff(c) || (isMember(c) && resource.data.by == request.auth.uid);
        allow create: if isMember(c) && request.resource.data.by == request.auth.uid
          && request.resource.data.rpe is number && request.resource.data.rpe >= 1 && request.resource.data.rpe <= 10;
        allow update, delete: if isClubAdmin(c);
      }
      // 会費：運営と、その会員の保護者だけ。書き込みは運営（カード決済の反映はCloud Functions）
      match /fees/{f} {
        allow read: if isClubAdmin(c) || (isMember(c) && request.auth.uid in resource.data.guardianUids);
        allow write: if isClubAdmin(c);
      }
      match /incidents/{i} {
        allow read, create: if isStaff(c);
        allow update, delete: if isClubAdmin(c);
      }
    }

    // 指導の依頼のメッセージ（依頼の当事者のみ）
    match /contracts/{k}/messages/{m} {
      function ct() { return get(/databases/$(database)/documents/contracts/$(k)).data; }
      allow read: if authed() && (request.auth.uid == ct().coach || request.auth.uid == ct().player);
      allow create: if authed() && (request.auth.uid == ct().coach || request.auth.uid == ct().player)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // AI利用回数の記録（サーバー専用）
    match /ai_usage/{id} { allow read, write: if false; }
  }
}
