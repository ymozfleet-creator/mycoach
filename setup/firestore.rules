rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isAdmin() {
      return authed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ユーザー：閲覧はログインユーザー全員、編集は本人と管理者のみ
    match /users/{uid} {
      // 本人による更新では verified は「変更なし」または「pending（申請）」のみ許可
      function selfVerifyOk() {
        return request.resource.data.get('verified','none') == resource.data.get('verified','none')
            || request.resource.data.get('verified','none') == 'pending';
      }
      allow read: if authed();
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.get('verified','none') != 'approved'
        && request.resource.data.get('isAdmin', false) != true;
      allow update: if isAdmin()
        || (authed() && request.auth.uid == uid
            && selfVerifyOk()
            && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
            // Stripe口座情報はFunctions（Admin SDK）のみが書き込む
            && request.resource.data.get('stripeAccountId', '') == resource.data.get('stripeAccountId', '')
            && request.resource.data.get('stripeChargesEnabled', false) == resource.data.get('stripeChargesEnabled', false))
        // レビュー投稿に伴う評価集計フィールドのみの更新は許可
        // （改ざん耐性を高めたい場合は functions の recalcRating を有効化し、この行を削除）
        || (authed()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg','ratingCount','lessonCount']));
      allow delete: if false; // 退会は deleted フラグで論理削除
    }

    // いいね：作成は本人（from）のみ
    match /likes/{id} {
      allow read: if authed();
      // ドキュメントIDは「送信者_受信者」に固定（本人以外のいいねを作れない）
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow update, delete: if false;
    }

    // マッチ：当事者のみ閲覧・作成（双方向いいね成立時にクライアントが作成）
    match /matches/{id} {
      // get: 存在しないdoc（resource == null）への読み取りを許容する。
      // これがないと「マッチ作成前の存在確認」が全ユーザーで拒否され、初回マッチが作れない。
      // 未存在docの読取を許すだけなので情報漏れは増えない
      allow get: if authed()
        && (resource == null || request.auth.uid in resource.data.users || isAdmin());
      // list: 当事者のクエリ（users array-contains 自分）または管理者のみ
      allow list: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      // 双方向の「いいね」が実在する場合のみマッチを作成できる（強制マッチの防止）
      allow create: if authed()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1]))
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0]));
      allow update, delete: if isAdmin();

      // チャット：マッチ当事者のみ
      match /messages/{mid} {
        allow read, create: if authed() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.users;
        allow update, delete: if false;
      }
    }

    // 契約：当事者と管理者のみ
    match /contracts/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed() && (request.auth.uid == request.resource.data.coach
                    || request.auth.uid == request.resource.data.player);
      allow update: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow delete: if false;
    }

    // 本人確認書類：本人の提出、本人と管理者のみ閲覧可
    match /verify_docs/{uid} {
      allow read: if authed() && (request.auth.uid == uid || isAdmin());
      allow create, update: if authed() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // 通報：作成は誰でも、閲覧・対応は管理者のみ
    match /reports/{id} {
      allow create: if authed();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // 通知：宛先本人のみ閲覧・既読化。作成はログインユーザー（いいね等の相手宛通知）
    match /notifications/{id} {
      allow read, update: if authed() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if authed()
        && request.resource.data.type in ['like','match','msg','contract','pay','review','verify','cert','announce']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.to is string;
      allow delete: if false;
    }

    // 決済：閲覧は当事者と管理者。
    // Stripe連携時はCloud Functions（Admin SDK）のみが書き込むため create を false に変更推奨。
    // 手動記録（銀行振込など）を使う場合のみ、支払者本人による create を許可する。
    match /payments/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed()
        && request.resource.data.player == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.fee is number && request.resource.data.fee >= 0;
      allow update: if isAdmin(); // 精算フラグ（payoutId）の付与のみ想定
      allow delete: if false;
    }

    // 精算（事務局→コーチへの振込記録）：作成は管理者のみ
    match /payouts/{id} {
      allow read: if authed() && (resource.data.coach == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Stripe Webhookの冪等化記録（サーバー専用）
    match /stripe_events/{id} {
      allow read, write: if false;
    }

    // レビュー：閲覧は全員、作成は投稿者本人のみ
    match /reviews/{id} {
      function ct() {
        return get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data;
      }
      allow read: if authed();
      // 完了済み契約の当事者のみ、契約相手に対して投稿できる
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && ct().status == 'completed'
        && (request.auth.uid == ct().coach || request.auth.uid == ct().player)
        && request.resource.data.to == (request.auth.uid == ct().coach ? ct().player : ct().coach);
      allow update, delete: if isAdmin();
    }

    // 指導者募集：閲覧はログインユーザー、作成・更新はチーム本人（と管理者）
    match /recruitments/{id} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.teamId == request.auth.uid;
      allow update: if authed() && (resource.data.teamId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 実績証明書：申請は本人、発行・失効は事務局のみ。
    // 証明書番号（推測困難なランダムID）を知る第三者は真正性を確認できる（get）
    match /certificates/{id} {
      allow get: if true;
      allow list: if authed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if authed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.stats == null;
      allow update, delete: if isAdmin();
    }

    // 運営からのお知らせ：閲覧は全ログインユーザー、配信は事務局のみ
    match /announcements/{id} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    // 管理操作の監査ログ：事務局のみ。改ざん防止のため更新・削除は不可
    match /audit_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // メール送信キュー（Trigger Email拡張専用。クライアントは触れない）
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
