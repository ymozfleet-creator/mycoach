rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    // 受取口座ゲートのサーバー強制（settings/platform.requireConnect==true のときのみ有効）
    function connectGateOn() {
      return exists(/databases/$(database)/documents/settings/platform)
        && get(/databases/$(database)/documents/settings/platform).data.requireConnect == true;
    }
    // ドキュメントIDは英数字・_・- だけ（IDに記号を混ぜて画面に不正なコードを埋め込む攻撃を防ぐ）
    function safeId(x) { return x is string && x.matches('^[A-Za-z0-9_-]{1,80}$'); }
    // 画面内リンクは「#英数字/_-」だけ
    function safeLink(x) { return x == null || (x is string && x.matches('^(#[A-Za-z0-9_/-]{0,80})?$')); }
    // 写真：JPEGのdata URLだけ・容量の上限つき（それ以外の形式や巨大なデータは保存できない）
    function photoOk(d, max) {
      return !('photo' in d) || d.photo == ''
        || (d.photo is string && d.photo.size() <= max && d.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'));
    }
    function isAdmin() {
      return authed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ユーザー：閲覧はログインユーザー全員、編集は本人と管理者のみ
    match /users/{uid} {
      // 本人による更新では verified は「変更なし」または「pending（申請）」のみ許可
      function selfVerifyOk() {
        return request.resource.data.get('verified','none') == resource.data.get('verified','none')
            || request.resource.data.get('verified','none') == 'pending';
      }
      allow read: if authed();
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.get('verified','none') != 'approved'
        && request.resource.data.get('isAdmin', false) != true
        && request.resource.data.get('stripeAccountId', '') == ''
        && request.resource.data.get('stripeChargesEnabled', false) == false
        && request.resource.data.get('ratingCount', 0) == 0
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.get('training', false) == false
        && request.resource.data.get('licenseVerified', false) == false
        && !('email' in request.resource.data) // メールアドレスは users_private に置く（公開プロフィールに載せない）
        && request.resource.data.get('name', '').size() <= 40
        && request.resource.data.get('bio', '').size() <= 1000
        && photoOk(request.resource.data, 100000);
      // 入力値の上限（大きなデータの書き込みや表示崩れを防ぐ）
      function profileSizeOk() {
        return request.resource.data.get('name', '').size() <= 40
          && request.resource.data.get('bio', '').size() <= 1000
          && request.resource.data.get('license', '').size() <= 100
          && request.resource.data.get('skills', []).size() <= 10
          && request.resource.data.get('ages', []).size() <= 5
          && request.resource.data.get('levels', []).size() <= 5
          && photoOk(request.resource.data, 100000);
      }
      allow update: if isAdmin()
        || (authed() && request.auth.uid == uid
            && selfVerifyOk()
            && profileSizeOk()
            // 差し戻し理由は事務局だけが書ける（本人は消すことのみ）
            && request.resource.data.get('verifyNote', '') in [resource.data.get('verifyNote', ''), '']
            && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
            // 資格の確認済みの印は事務局だけが付けられる
            && request.resource.data.get('licenseVerified', false) == resource.data.get('licenseVerified', false)
            // 利用停止は事務局だけが解除できる。退会（deleted）は本人が付けることはできても外せない
            && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
            && (request.resource.data.get('deleted', false) == resource.data.get('deleted', false) || request.resource.data.get('deleted', false) == true)
            && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
            // メールアドレスを公開プロフィールに新しく書き込むことはできない（削除は可）
            && (!('email' in request.resource.data) || request.resource.data.email == resource.data.get('email', null))
            // Stripe口座情報はFunctions（Admin SDK）のみが書き込む
            && request.resource.data.get('stripeAccountId', '') == resource.data.get('stripeAccountId', '')
            && request.resource.data.get('stripeChargesEnabled', false) == resource.data.get('stripeChargesEnabled', false)
            // 評価・指導回数はサーバー（recalcRating / recalcLessons）だけが更新する
            && request.resource.data.get('ratingAvg', 0) == resource.data.get('ratingAvg', 0)
            && request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0)
            && request.resource.data.get('lessonCount', 0) == resource.data.get('lessonCount', 0));
      allow delete: if false; // 退会は deleted フラグで論理削除
    }

    // 紹介ページからのお問い合わせ：書き込みはサーバーのみ、閲覧は事務局だけ
    match /inquiries/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // 非公開のユーザー情報（メールアドレス）：本人と事務局だけ
    match /users_private/{uid} {
      allow read: if authed() && (request.auth.uid == uid || isAdmin());
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // いいね：作成は本人（from）のみ
    match /likes/{id} {
      allow read: if authed();
      // ドキュメントIDは「送信者_受信者」に固定（本人以外のいいねを作れない）
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow update, delete: if false;
    }

    // マッチ：当事者のみ閲覧・作成（双方向いいね成立時にクライアントが作成）
    match /matches/{id} {
      // get: 存在しないdoc（resource == null）への読み取りを許容する。
      // これがないと「マッチ作成前の存在確認」が全ユーザーで拒否され、初回マッチが作れない。
      // 未存在docの読取を許すだけなので情報漏れは増えない
      allow get: if authed()
        && (resource == null || request.auth.uid in resource.data.users || isAdmin());
      // list: 当事者のクエリ（users array-contains 自分）または管理者のみ
      allow list: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      // 双方向の「いいね」が実在する場合のみマッチを作成できる（強制マッチの防止）
      allow create: if authed() && safeId(id)
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1]))
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0]));
      allow update, delete: if isAdmin();

      // チャット：マッチ当事者のみ
      match /messages/{mid} {
        allow read: if authed() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.users;
        // 送信者のなりすまし防止と文字数の上限
        allow create: if authed() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.users
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // 契約：当事者と管理者のみ
    match /contracts/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin()
                    // クラブの運営は、自分のクラブが支払った謝金の記録を読める
                    || (resource.data.get('clubId', '') != '' && isClubAdmin(resource.data.clubId)));
      // MyCOACH-MyTEAM：クラブと指導者の依頼・応募（clubId を持つ契約）
      function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
      function clubContractCreateOk() {
        let d = request.resource.data;
        return d.by == request.auth.uid
          && d.status == 'proposed'
          && d.fee is int && d.fee >= 0 && d.fee <= 100000
          && d.title is string && d.title.size() <= 60
          && d.get('message', '').size() <= 1000
          && request.auth.uid in [d.coach, d.player]
          && d.coach != d.player
          // クラブ側の相手（player）は、そのクラブの運営者であること
          && d.player in club(d.clubId).adminUids
          && (
            // 運営者からの依頼：添付する招待コードは、そのクラブの指導者用であること
            (request.auth.uid == d.player
              && (!('clubCode' in d) || (invite(d.clubCode).clubId == d.clubId && invite(d.clubCode).role == 'coach')))
            // 指導者からの応募：本人確認と安全研修が済んでいること。招待コードは付けられない
            || (request.auth.uid == d.coach && !('clubCode' in d)
              && me().get('verified', 'none') == 'approved' && me().get('training', false) == true)
          );
      }
      function clubContractUpdateOk() {
        let a = resource.data;
        let b = request.resource.data;
        return b.diff(a).affectedKeys().hasOnly(['status', 'reviewed'])
          && (
            // 返事（引き受け・採用・お断り）は、依頼・応募を受けた側だけができる
            (a.status == 'proposed' && b.status in ['active', 'declined'] && request.auth.uid != a.get('by', a.player))
            // 依頼・応募を出した本人は、返事が来る前なら取り下げられる
            || (a.status == 'proposed' && b.status == 'withdrawn' && request.auth.uid == a.get('by', a.player))
            // 指導の終了は当事者のどちらでも
            || (a.status == 'active' && b.status == 'completed')
            // 評価済みの印は、終了後にクラブ側だけが付けられる
            || (a.status == 'completed' && b.status == 'completed' && request.auth.uid == a.player && b.get('reviewed', false) == true)
          );
      }
      // 旧MyCOACH（個人レッスン）の契約：マッチした相手とだけ、提案者本人が作成できる
      function lessonContractCreateOk() {
        let d = request.resource.data;
        return d.proposer == request.auth.uid
          && d.status == 'proposed'
          && d.fee is number && d.fee >= 0 && d.fee <= 1000000
          && d.get('title', '').size() <= 100
          && d.get('detail', '').size() <= 2000
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(d.matchId)).data.users
          && get(/databases/$(database)/documents/matches/$(d.matchId)).data.users.hasAll([d.coach, d.player]);
      }
      // 金額・相手などは契約後に変えられない。承諾は提案を受けた側、取り下げは提案者
      function lessonContractUpdateOk() {
        let a = resource.data;
        let b = request.resource.data;
        return b.diff(a).affectedKeys().hasOnly(['status', 'decidedTs', 'nextLesson', 'nextLessonAt', 'log'])
          && (
            b.status == a.status
            || (a.status == 'proposed' && b.status in ['active', 'declined'] && request.auth.uid != a.get('proposer', ''))
            || (a.status == 'proposed' && b.status == 'cancelled' && request.auth.uid == a.get('proposer', ''))
            || (a.status == 'active' && b.status in ['completed', 'cancelled'])
          );
      }
      allow create: if authed() && safeId(id) && (request.auth.uid == request.resource.data.coach
                    || request.auth.uid == request.resource.data.player)
        && request.resource.data.coach != request.resource.data.player
        && (('clubId' in request.resource.data) ? clubContractCreateOk() : lessonContractCreateOk());
      allow update: if authed()
        && (request.auth.uid == resource.data.coach
            || request.auth.uid == resource.data.player || isAdmin())
        && (isAdmin() || (('clubId' in resource.data) ? clubContractUpdateOk() : lessonContractUpdateOk()))
        // 契約開始（active への遷移）は、ゲート強制ON時はコーチの受取口座設定を必須にする
        && (isAdmin()
            || !(request.resource.data.status == 'active' && resource.data.status != 'active')
            || !connectGateOn()
            || get(/databases/$(database)/documents/users/$(resource.data.coach)).data.stripeChargesEnabled == true);
      allow delete: if false;
    }

    // 本人確認書類：本人の提出、本人と管理者のみ閲覧可
    match /verify_docs/{uid} {
      allow read: if authed() && (request.auth.uid == uid || isAdmin());
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.get('image', '') is string
        && request.resource.data.get('image', '').size() <= 480000
        && request.resource.data.get('licenseImage', '') is string
        && request.resource.data.get('licenseImage', '').size() <= 480000
        && request.resource.data.get('docType', '').size() <= 40;
      allow delete: if isAdmin();
    }

    // 通報：作成は誰でも、閲覧・対応は管理者のみ
    match /reports/{id} {
      allow create: if authed() && safeId(id)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.get('status', 'new') == 'new'
        && request.resource.data.get('targetType', 'user') in ['user', 'post', 'club']
        && request.resource.data.get('targetName', '').size() <= 80
        && request.resource.data.get('reason', '').size() <= 100
        && request.resource.data.get('detail', '').size() <= 2000;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // 通知：宛先本人のみ閲覧・既読化。作成はログインユーザー（いいね等の相手宛通知）
    match /notifications/{id} {
      allow read: if authed() && (resource.data.to == request.auth.uid || isAdmin());
      // 既読にするだけ（本文の書き換えは不可）
      allow update: if isAdmin() || (authed() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow create: if authed()
        && (request.resource.data.type in ['like','match','msg','contract','pay','review','cert','announce']
            || (request.resource.data.type == 'verify' && isAdmin())) // 審査結果の通知は事務局だけ
        && request.resource.data.get('read', false) == false
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.to is string
        // 送信者を必ず記録（なりすまし防止・迷惑行為の追跡）。リンクは画面内のみ
        && request.resource.data.from == request.auth.uid
        && safeLink(request.resource.data.get('link', null));
      allow delete: if false;
    }

    // 決済：閲覧は当事者と管理者。
    // Stripe連携時はCloud Functions（Admin SDK）のみが書き込むため create を false に変更推奨。
    // 手動記録（銀行振込など）を使う場合のみ、支払者本人による create を許可する。
    match /payments/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      // 支払いの記録はStripeのWebhook（サーバー）だけが作る。画面から「支払い済み」を偽装できない
      allow create: if false;
      allow update: if isAdmin(); // 精算フラグ（payoutId）の付与のみ想定
      allow delete: if isAdmin(); // 誤記録の取消（管理画面から。監査ログに記録される）
    }

    // 精算（事務局→コーチへの振込記録）：作成は管理者のみ
    match /payouts/{id} {
      allow read: if authed() && (resource.data.coach == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Stripe Webhookの冪等化記録（サーバー専用）
    match /stripe_events/{id} {
      allow read, write: if false;
    }

    // レビュー：閲覧は全員、作成は投稿者本人のみ
    match /reviews/{id} {
      function ct() {
        return get(/databases/$(database)/documents/contracts/$(request.resource.data.contractId)).data;
      }
      allow read: if authed();
      // 完了済み契約の当事者のみ、契約相手に対して投稿できる
      allow create: if authed()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && ct().status == 'completed'
        && (request.auth.uid == ct().coach || request.auth.uid == ct().player)
        && request.resource.data.to == (request.auth.uid == ct().coach ? ct().player : ct().coach)
        && request.resource.data.get('text', '').size() <= 500
        // 1件の契約につき1人1回だけ（ドキュメントIDを固定）
        && id == request.resource.data.contractId + '_' + request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 指導者募集：閲覧はログインユーザー、作成・更新はチーム本人（と管理者）
    match /recruitments/{id} {
      allow read: if authed();
      allow create: if authed() && safeId(id) && request.resource.data.teamId == request.auth.uid
        && request.resource.data.get('title', '').size() <= 100
        && request.resource.data.get('detail', '').size() <= 2000;
      allow update: if authed() && (isAdmin() || (resource.data.teamId == request.auth.uid
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.get('title', '').size() <= 100
        && request.resource.data.get('detail', '').size() <= 2000));
      allow delete: if isAdmin();
    }

    // 実績証明書：申請は本人、発行・失効は事務局のみ。
    // 証明書番号（推測困難なランダムID）を知る第三者は真正性を確認できる（get）
    match /certificates/{id} {
      allow get: if true;
      allow list: if authed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if authed() && safeId(id)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.stats == null;
      allow update, delete: if isAdmin();
    }

    // レッスン予約（空き枠予約）：契約当事者のみ作成・閲覧・返答できる
    match /bookings/{id} {
      allow get: if authed() && (resource == null || request.auth.uid in resource.data.users || isAdmin());
      allow list: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      allow create: if authed() && safeId(id)
        && request.auth.uid in request.resource.data.users
        && request.resource.data.by == request.auth.uid
        && request.resource.data.users.hasAll([request.resource.data.coach, request.resource.data.player]);
      allow update: if authed() && (request.auth.uid in resource.data.users)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users', 'coach', 'player', 'by', 'contractId']);
      allow delete: if false;
    }

    // プラットフォーム設定（受取口座ゲートの強制など）：変更は事務局のみ
    match /settings/{id} {
      allow read: if authed();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // 運営からのお知らせ：閲覧は全ログインユーザー、配信は事務局のみ
    match /announcements/{id} {
      allow read: if authed();
      allow create, update, delete: if isAdmin();
    }

    // 管理操作の監査ログ：事務局のみ。改ざん防止のため更新・削除は不可
    match /audit_logs/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // メール送信キュー（Trigger Email拡張専用。クライアントは触れない）
    match /mail/{id} {
      allow read, write: if false;
    }
  
    /* =================================================================
       MyCOACH-MyTEAM（地域クラブ運営）
       ================================================================= */
    function club(c) { return get(/databases/$(database)/documents/clubs/$(c)).data; }
    function isMember(c) { return authed() && request.auth.uid in club(c).memberUids; }
    function isClubAdmin(c) { return authed() && request.auth.uid in club(c).adminUids; }
    function isStaff(c) { return authed() && (request.auth.uid in club(c).adminUids || request.auth.uid in club(c).coachUids); }
    // 学校・教育委員会：活動状況と安全記録の閲覧（会費・体調の記録は見られない）
    function isSchool(c) { return authed() && request.auth.uid in club(c).get('schoolUids', []); }
    // 自分自身だけを配列に追加する変更か
    function onlyAddsMe(field) {
      return request.resource.data.get(field, []).hasAll(resource.data.get(field, []))
        && request.resource.data.get(field, []).removeAll(resource.data.get(field, [])).hasOnly([request.auth.uid]);
    }

    // 招待コード → クラブID。コードを知っている人だけが引ける（一覧は不可）
    match /invites/{code} {
      allow get: if authed();
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/invites/$(code))
        && isClubAdmin(request.resource.data.clubId)
        && request.resource.data.keys().hasOnly(['clubId', 'role'])
        && request.resource.data.role in ['member', 'coach', 'school'];
      allow update, delete: if false;
    }

    function invite(code) { return get(/databases/$(database)/documents/invites/$(code)).data; }
    match /clubs/{c} {
      // 会員のみ閲覧可（招待コードを含むため）
      allow get: if isMember(c);
      allow list: if false;
      allow create: if authed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.coachUids.size() == 0
        && request.resource.data.get('schoolUids', []).size() == 0
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      // 運営は自由に更新。それ以外は「正しい招待コードで、自分を会員に加える」だけ許可。
      // 指導者（coachUids）への追加は、指導者用の招待コードの場合のみ
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo']) && request.resource.data.photo == '')
        || (isClubAdmin(c) && photoOk(request.resource.data, 200000)
          && request.resource.data.get('dbs', {}).keys().hasOnly(['certified', 'allChecked', 'at'])
          && request.resource.data.get('insurance', {}).get('name', '').size() <= 40)
        || (authed()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'coachUids', 'schoolUids', 'joinCode'])
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
            && invite(request.resource.data.joinCode).clubId == c
            && onlyAddsMe('memberUids')
            && (request.resource.data.get('coachUids', []) == resource.data.get('coachUids', [])
                || (onlyAddsMe('coachUids') && invite(request.resource.data.joinCode).role == 'coach'))
            && (request.resource.data.get('schoolUids', []) == resource.data.get('schoolUids', [])
                || (onlyAddsMe('schoolUids') && invite(request.resource.data.joinCode).role == 'school')));
      allow delete: if false;

      // 会員：運営・指導者は全員分、保護者は自分の家庭の分だけ
      match /players/{p} {
        allow read: if isStaff(c) || isSchool(c) || (isMember(c) && request.auth.uid in resource.data.guardianUids);
        allow create: if safeId(p) && (isClubAdmin(c) || (isMember(c) && request.resource.data.guardianUids == [request.auth.uid] && request.resource.data.discount == 0
          && request.resource.data.name is string && request.resource.data.name.size() <= 40));
        // 保護者の追加・変更は運営だけ（他の家庭の子どもに自分を保護者として登録できない）
        allow update: if isClubAdmin(c);
        allow delete: if isClubAdmin(c);
      }
      // 予定：運営・指導者が作成。会員は出欠（att）だけ更新できる
      match /events/{e} {
        allow read: if isMember(c);
        allow create, delete: if isStaff(c);
        // 会員は「自分が保護者になっている子ども」の出欠だけを変更できる
        allow update: if isStaff(c) || (isMember(c)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['att', 'attBy'])
          && request.resource.data.attBy.u == request.auth.uid
          && request.resource.data.get('att', {}).diff(resource.data.get('att', {})).affectedKeys().hasOnly([request.resource.data.attBy.p])
          && request.resource.data.att[request.resource.data.attBy.p] in ['yes', 'no', 'maybe']
          && request.auth.uid in get(/databases/$(database)/documents/clubs/$(c)/players/$(request.resource.data.attBy.p)).data.guardianUids);
      }
      // 欠席の理由：他の保護者には見せない（予定とは別に保存）。運営・指導者と、入力した保護者だけが読める
      match /attNotes/{n} {
        allow read: if isStaff(c) || (isMember(c) && resource.data.by == request.auth.uid);
        allow create, update: if isMember(c)
          && n == request.resource.data.eventId + '_' + request.resource.data.playerId
          && request.resource.data.by == request.auth.uid
          && request.resource.data.note is string && request.resource.data.note.size() <= 60
          && request.resource.data.keys().hasOnly(['eventId', 'playerId', 'note', 'by', 'at'])
          && (isStaff(c) || request.auth.uid in get(/databases/$(database)/documents/clubs/$(c)/players/$(request.resource.data.playerId)).data.guardianUids);
        allow delete: if isClubAdmin(c);
      }
      match /announcements/{a} {
        allow read: if isMember(c);
        allow create: if isStaff(c) && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update, delete: if isClubAdmin(c);
      }
      // 体調・練習記録：運営・指導者と、記録した本人だけが読める
      match /conditions/{x} {
        // 保護者は自分が記録したものと、自分の子どもの記録（guardianUids に自分が入っているもの）を読める
        allow read: if isStaff(c) || (isMember(c) && (resource.data.by == request.auth.uid || request.auth.uid in resource.data.get('guardianUids', [])));
        allow create: if isMember(c) && request.resource.data.by == request.auth.uid
          && (isStaff(c) || request.auth.uid in get(/databases/$(database)/documents/clubs/$(c)/players/$(request.resource.data.playerId)).data.guardianUids)
          // 読める保護者の一覧は、選手に登録されている保護者と同じでなければならない（他人に見せる細工を防ぐ）
          && request.resource.data.get('guardianUids', []) == get(/databases/$(database)/documents/clubs/$(c)/players/$(request.resource.data.playerId)).data.get('guardianUids', [])
          && request.resource.data.rpe is number && request.resource.data.rpe >= 1 && request.resource.data.rpe <= 10
          && request.resource.data.minutes is number && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 600
          && request.resource.data.sleep is number && request.resource.data.sleep >= 0 && request.resource.data.sleep <= 24;
        allow update, delete: if isClubAdmin(c);
      }
      // 会費：運営と、その会員の保護者だけ。書き込みは運営（カード決済の反映はCloud Functions）
      match /fees/{f} {
        allow read: if isClubAdmin(c) || (isMember(c) && request.auth.uid in resource.data.guardianUids);
        allow write: if isClubAdmin(c);
      }
      // 会費の減免の申請：保護者が自分の子どもについて申請し、運営が承認・却下する
      match /feeRequests/{r} {
        allow read: if isClubAdmin(c) || (isMember(c) && resource.data.by == request.auth.uid);
        allow create: if isMember(c) && safeId(r)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.discount in [50, 100]
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 40
          && request.resource.data.playerName is string && request.resource.data.playerName.size() <= 40
          && request.auth.uid in get(/databases/$(database)/documents/clubs/$(c)/players/$(request.resource.data.playerId)).data.guardianUids;
        allow update: if isClubAdmin(c)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
          && request.resource.data.status in ['approved', 'declined']
          && request.resource.data.get('note', '').size() <= 500;
        allow delete: if false;
      }
      // 施設（学校の体育館など）の利用申請：運営が申請し、学校が承認する
      match /facilityRequests/{r} {
        allow read: if isStaff(c) || isSchool(c);
        allow create: if isClubAdmin(c) && safeId(r)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.venue is string && request.resource.data.venue.size() > 0 && request.resource.data.venue.size() <= 60
          && request.resource.data.purpose is string && request.resource.data.purpose.size() <= 300
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.start is string && request.resource.data.start.matches('^[0-9]{2}:[0-9]{2}$')
          && request.resource.data.minutes is int && request.resource.data.minutes > 0 && request.resource.data.minutes <= 720;
        allow update: if (isSchool(c) || isClubAdmin(c))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note'])
          && request.resource.data.status in (isSchool(c) ? ['approved', 'declined'] : ['declined'])
          && request.resource.data.get('note', '').size() <= 300;
        allow delete: if false;
      }
      // 犯罪事実確認（こども性暴力防止法）の「実施日と次回の期限」だけを記録する。
      // 確認の結果は記録できない（項目を限定）。閲覧・記録は運営のみ
      match /staffChecks/{s} {
        allow read: if isClubAdmin(c);
        allow create, update: if isClubAdmin(c) && safeId(s)
          && request.resource.data.keys().hasOnly(['name', 'lastAt', 'nextDue'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.lastAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.nextDue.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow delete: if isClubAdmin(c);
      }
      // 相談窓口：会員（保護者・生徒）が運営に相談する。匿名のときは送り主を記録しない
      match /consults/{x} {
        allow read: if isClubAdmin(c) || isAdmin();
        allow create: if isMember(c) && safeId(x)
          && request.resource.data.status == 'new'
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.category is string && request.resource.data.category.size() <= 30
          && ((request.resource.data.anonymous == true && request.resource.data.by == '' && request.resource.data.byName == '')
            || (request.resource.data.anonymous == false && request.resource.data.by == request.auth.uid && request.resource.data.byName.size() <= 40));
        allow update: if (isClubAdmin(c) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'done';
        allow delete: if false;
      }
      match /incidents/{i} {
        allow read: if isStaff(c) || isSchool(c);
        allow create: if (isStaff(c) || isSchool(c))
          && request.resource.data.get('desc', '').size() <= 2000
          && request.resource.data.get('action', '').size() <= 2000
          && request.resource.data.get('who', '').size() <= 100;
        allow update, delete: if isClubAdmin(c);
      }
    }

    // 指導者の募集：閲覧はログインユーザー、作成・更新はそのクラブの運営者
    match /club_posts/{id} {
      function postOk(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.note is string && d.note.size() <= 1000
          && d.fee is int && d.fee >= 0 && d.fee <= 100000
          && d.status in ['open', 'closed']
          && d.days is list && d.days.size() <= 7
          && d.get('skills', []).size() <= 10
          && d.get('ages', []).size() <= 5
          && d.get('level', '').size() <= 30
          && photoOk(d, 200000);
      }
      allow read: if authed();
      allow create: if isClubAdmin(request.resource.data.clubId)
        && request.resource.data.ownerUid == request.auth.uid
        && postOk(request.resource.data);
      allow update: if (isClubAdmin(resource.data.clubId)
        && request.resource.data.clubId == resource.data.clubId
        && postOk(request.resource.data))
        // 事務局：通報を受けて写真を外し、募集を締め切る（それ以外は変えられない）
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'status'])
          && request.resource.data.photo == '' && request.resource.data.status == 'closed');
      allow delete: if false;
    }

    // 指導の依頼のメッセージ（依頼の当事者のみ）
    match /contracts/{k}/messages/{m} {
      function ct() { return get(/databases/$(database)/documents/contracts/$(k)).data; }
      allow read: if authed() && (request.auth.uid == ct().coach || request.auth.uid == ct().player);
      allow create: if authed() && (request.auth.uid == ct().coach || request.auth.uid == ct().player)
        && request.resource.data.from == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // AI利用回数の記録（サーバー専用）
    match /ai_usage/{id} { allow read, write: if false; }
  }
}
