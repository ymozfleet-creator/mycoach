rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isAdmin() {
      return authed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ユーザー：閲覧はログインユーザー全員、編集は本人と管理者のみ
    match /users/{uid} {
      // 本人による更新では verified は「変更なし」または「pending（申請）」のみ許可
      function selfVerifyOk() {
        return request.resource.data.get('verified','none') == resource.data.get('verified','none')
            || request.resource.data.get('verified','none') == 'pending';
      }
      allow read: if authed();
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.get('verified','none') != 'approved'
        && request.resource.data.get('isAdmin', false) != true;
      allow update: if isAdmin()
        || (authed() && request.auth.uid == uid
            && selfVerifyOk()
            && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
            // Stripe口座情報はFunctions（Admin SDK）のみが書き込む
            && request.resource.data.get('stripeAccountId', '') == resource.data.get('stripeAccountId', '')
            && request.resource.data.get('stripeChargesEnabled', false) == resource.data.get('stripeChargesEnabled', false));
      allow delete: if false; // 退会は deleted フラグで論理削除
    }

    // いいね：作成は本人（from）のみ
    match /likes/{id} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // マッチ：当事者のみ閲覧・作成（双方向いいね成立時にクライアントが作成）
    match /matches/{id} {
      allow read: if authed() && (request.auth.uid in resource.data.users || isAdmin());
      allow create: if authed() && request.auth.uid in request.resource.data.users;
      allow update, delete: if isAdmin();

      // チャット：マッチ当事者のみ
      match /messages/{mid} {
        allow read, create: if authed() &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(id)).data.users;
        allow update, delete: if false;
      }
    }

    // 契約：当事者と管理者のみ
    match /contracts/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed() && (request.auth.uid == request.resource.data.coach
                    || request.auth.uid == request.resource.data.player);
      allow update: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow delete: if false;
    }

    // 通報：作成は誰でも、閲覧・対応は管理者のみ
    match /reports/{id} {
      allow create: if authed();
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // 通知：宛先本人のみ閲覧・既読化。作成はログインユーザー（いいね等の相手宛通知）
    match /notifications/{id} {
      allow read, update: if authed() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if authed();
      allow delete: if false;
    }

    // 決済：閲覧は当事者と管理者。
    // Stripe連携時はCloud Functions（Admin SDK）のみが書き込むため create を false に変更推奨。
    // 手動記録（銀行振込など）を使う場合のみ、支払者本人による create を許可する。
    match /payments/{id} {
      allow read: if authed() && (request.auth.uid == resource.data.coach
                    || request.auth.uid == resource.data.player || isAdmin());
      allow create: if authed() && request.resource.data.player == request.auth.uid;
      allow update: if isAdmin(); // 精算フラグ（payoutId）の付与のみ想定
      allow delete: if false;
    }

    // 精算（事務局→コーチへの振込記録）：作成は管理者のみ
    match /payouts/{id} {
      allow read: if authed() && (resource.data.coach == request.auth.uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Stripe Webhookの冪等化記録（サーバー専用）
    match /stripe_events/{id} {
      allow read, write: if false;
    }

    // レビュー：閲覧は全員、作成は投稿者本人のみ
    match /reviews/{id} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.from == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // メール送信キュー（Trigger Email拡張専用。クライアントは触れない）
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
